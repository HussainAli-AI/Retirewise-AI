# RetireWise AI Environment Configuration

# AI Provider: "groq", "gemini", "openai", or "mock" (offline fallback)
AI_PROVIDER=mock

# Groq API Key (ultra-fast inference with Llama 3.3)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (optional if using gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here

# Database configuration
DATABASE_PATH=retirewise.db

# App Settings
APP_ENV=development
DEFAULT_CURRENCY=PKR
